# Responsible for listing every environment variable the project reads.
# Names only. Never commit real values: this repo is public.
# Local runs need only APP_ENV, JWT_SECRET, SQL_CONNECTION_STRING and the three mode switches set to mock/local.

# App
APP_ENV=local
JWT_SECRET=
API_URL=

# Mode switches: mock or azure / local or azure
LLM_PROVIDER=mock
RETRIEVER=local
ML_PROVIDER=local

# Azure AI Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX_NAME=

# Azure SQL
SQL_CONNECTION_STRING=

# Blob Storage
AZURE_STORAGE_CONNECTION_STRING=

# Azure ML endpoints
RADAR_ENDPOINT_URL=
RADAR_ENDPOINT_KEY=
INTENT_ENDPOINT_URL=
INTENT_ENDPOINT_KEY=

# Used by make deploy-infra
RG=
SQL_ADMIN_PASSWORD=

# Used by the Azure ML scripts in ml/azureml/scripts
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
